{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"]
  },
  "include": [
    "build",
    "src",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist"
  ]
}
